tools/venv
tools/adbkey/
__pycache__/
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
# your own TV's dumps (serial, android_id, device names) stay local
backup/
# session screenshots and working notes (may show the Wi-Fi name or account avatar) stay local
shots/
work/
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
# tools/bench.py results: they hold the TV's build fingerprint and model
bench-results/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log

tools/venv/
vpn-evidence/
# preview/tools/install_preview.py records: hashes and versions only, kept local with the other evidence
preview-evidence/
# preview/tools/home_recovery.py records: which app answers Home, never addresses
home-evidence/
# Signing keys are never committed (preview/tools/make_preview_key.py keeps them outside the repository)
*.jks
*.keystore
*.p12
*.pfx
