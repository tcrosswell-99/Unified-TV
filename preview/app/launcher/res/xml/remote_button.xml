<?xml version="1.0" encoding="utf-8"?>
<!-- OD-31, the remote button that opens Unified TV (ButtonService; launcher app only). Keys only: no event types (so the
     system never sends it accessibility events), no window content, no gestures. Key filtering is asked for here and is
     dropped again at run time whenever the household has the option off (RemoteButton.wantsKeys). It reacts to the one
     chosen button and passes every other key on untouched. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/remote_button_description"/>
